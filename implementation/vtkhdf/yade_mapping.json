{
  "_comment": "ON-DEM schema field → YADE Python API mapping. Verified against FrictPhys and ScGeom attributes for Law2_ScGeom_FrictPhys_CundallStrack.",

  "_collections": {
    "bodies":       "[b for b in O.bodies if b is not None]",
    "interactions": "[i for i in O.interactions if i.isReal]"
  },

  "scene": {
    "time":      "O.time + (float(O.tags['ondem_time_offset']) if 'ondem_time_offset' in O.tags.keys() else 0.0)",
    "timestep":  "O.dt",
    "gravity":   "_get_gravity()",
    "units":     "['second', 'meter', 'kilogram']",
    "display_group_names": "_display_group_names()",
    "iteration": "O.iter + (int(O.tags['ondem_iteration_offset']) if 'ondem_iteration_offset' in O.tags.keys() else 0)",
    "shape_names": "_shape_names()"
  },

  "_refuse_if": {
    "periodic scenes (O.periodic) are not supported yet: the periodic cell would not be written": "O.periodic"
  },

  "base_body": {
    "body_id":    "b.id",
    "material_id":"b.material.id",
    "clump_id":   "-1 if b.isClump else b.clumpId",
    "display_group": "_display_group(b)",
    "shape_type": "_shape_type_index(b)",
    "clump_relative_position":    "O.bodies[b.clumpId].shape.members[b.id][0] if b.isClumpMember else None",
    "clump_relative_orientation": "(lambda q: [q[3], q[0], q[1], q[2]])(O.bodies[b.clumpId].shape.members[b.id][1]) if b.isClumpMember else None"
  },

  "base_state": {
    "position":         "b.state.pos",
    "velocity":         "b.state.vel",
    "orientation":      "[b.state.ori[3], b.state.ori[0], b.state.ori[1], b.state.ori[2]]",
    "angular_velocity": "b.state.angVel",
    "mass":             "b.state.mass",
    "inertia":          "_diag3(b.state.inertia)",
    "volume":           "_sphere_volume(b)",
    "blocked_dofs":     "sum(1 << 'xyzXYZ'.index(c) for c in b.state.blockedDOFs)"
  },

  "_extra_body_fields": {
    "group_mask":       "b.groupMask",
    "is_damped":        "b.state.isDamped",
    "angular_momentum": "b.state.angMom",
    "density_scaling":  "b.state.densityScaling"
  },

  "_shape_type": "type(b.shape).__name__",

  "_shape_groups": {
    "Sphere":    "sphere",
    "Box":       "box",
    "Polyhedra": "polyhedron",
    "Wall":      "wall",
    "Facet":     "facet",
    "Clump":     "clump"
  },

  "_shape_names": ["sphere", "box", "polyhedron", "clump", "wall", "facet", "other"],

  "_extra_shapes": {
    "wall": {
      "axis":  "b.shape.axis if type(b.shape).__name__ == 'Wall' else None",
      "sense": "b.shape.sense if type(b.shape).__name__ == 'Wall' else None"
    },
    "facet": {
      "vertices": "[[v[0],v[1],v[2]] for v in b.shape.vertices] if type(b.shape).__name__ == 'Facet' else None",
      "normal":   "b.shape.normal if type(b.shape).__name__ == 'Facet' else None"
    }
  },

  "thermal": {
    "temperature": "b.state.T"
  },

  "liquid_film": {
    "liquid_film_volume": "b.state.liquidFilmVolume"
  },

  "sphere": {
    "radius": "b.shape.radius"
  },

  "box": {
    "dimensions": "[b.shape.extents[0]*2, b.shape.extents[1]*2, b.shape.extents[2]*2]"
  },

  "polyhedron": {
    "vertices": "[[v[0],v[1],v[2]] for v in b.shape.vertices]"
  },

  "_material_classes": ["linear_elastic_frictional_3D"],
  "_material_classes_note": "the inheritance of the material classes will be reworked with the other codes (decision 24)",

  "linear_elastic_frictional_3D": {
    "id":               "mat.id",
    "density":          "mat.density",
    "normal_stiffness": "mat.young",
    "shear_stiffness":  "mat.young * mat.poisson",
    "shear_friction":   "float(np.tan(mat.frictionAngle))",
    "shear_damping":    "0.0"
  },

  "_interaction_type": "type(i.phys).__name__",

  "base_interaction": {
    "id1":      "i.id1",
    "id2":      "i.id2",
    "virtual":  "not i.isReal",
    "lifespan": "0.0"
  },

  "normal": {
    "normal":       "i.geom.normal",
    "normal_force": "0.0 - i.phys.normalForce.dot(i.geom.normal)"
  },

  "linear_frictional_3D": {
    "friction_coefficient": "i.phys.tangensOfFrictionAngle"
  },

  "shear": {
    "shear_force": "i.phys.shearForce"
  },

  "shear_linear": {
    "ks": "i.phys.ks"
  },

  "normal_linear": {
    "kn": "i.phys.kn"
  },

  "normal_hertz": {
    "hertz_young":   "i.phys.young if hasattr(i.phys,'young') else float('nan')",
    "hertz_poisson": "i.phys.poisson if hasattr(i.phys,'poisson') else float('nan')"
  },

  "_interaction_geometry": {
    "contact_point":      "i.geom.contactPoint",
    "overlap":            "i.geom.penetrationDepth",
    "reference_radius_1": "i.geom.refR1",
    "reference_radius_2": "i.geom.refR2"
  },

  "_extra_material_attributes": {
    "label":              "mat.label if mat.label else ''",
    "material_type":      "type(mat).__name__",
    "yade_poisson":       "mat.poisson"
  },

  "_extra_interaction_attributes": {
    "geom_type":                        "type(i.geom).__name__",
    "phys_type":                        "type(i.phys).__name__",
    "normal_stiffness":                 "i.phys.kn if hasattr(i.phys,'kn') else float('nan')",
    "shear_stiffness":                  "i.phys.ks if hasattr(i.phys,'ks') else float('nan')",
    "frictional_dissipation":           "i.phys.frictDissip"
  }
}
